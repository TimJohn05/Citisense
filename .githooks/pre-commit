#!/usr/bin/env bash
set -euo pipefail

blocked=0

fail() {
  printf '\n  pre-commit: %s\n\n' "$1" >&2
  blocked=1
}

staged=$(git diff --cached --name-only --diff-filter=ACM)

while IFS= read -r file; do
  [ -n "$file" ] || continue
  case "$file" in
    .githooks/*)
      continue
      ;;
    */google-services.json|*/firebase_options.dart)
      fail "$file holds live project identifiers and must stay out of git."
      continue
      ;;
    *.p12|*.jks|*.keystore|*.p8|*.pem|.env|.env.*|serviceAccount*.json)
      fail "$file looks like a credential file."
      continue
      ;;
  esac
  [ -f "$file" ] || continue
  if grep -aEq 'AIza[0-9A-Za-z_-]{35}' "$file"; then
    fail "$file contains a Google/Firebase API key."
  fi
  if grep -aEq -- '-----BEGIN [A-Z ]*PRIVATE KEY-----' "$file"; then
    fail "$file contains a private key block."
  fi
  if grep -aEq 'AKIA[0-9A-Z]{16}|ghp_[0-9A-Za-z]{36}|github_pat_|xox[baprs]-|sk-[0-9A-Za-z]{20,}' "$file"; then
    fail "$file contains what looks like a cloud or vendor access token."
  fi
  if grep -aqE '"type"[[:space:]]*:[[:space:]]*"service_account"' "$file"; then
    fail "$file looks like a service account key."
  fi
done <<< "$staged"

if [ "$blocked" -eq 0 ]; then
  printf '\n  pre-commit: staged files look clean.\n\n'
fi

exit "$blocked"
